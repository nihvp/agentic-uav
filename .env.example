# Copy to .env (git-ignored); docker compose reads it automatically.
# Local LLM served by the llm service. Must support tool calling. 16 GB VRAM is
# shared with Gazebo: stay around 9-10 GB of weights (14B at 4-bit).
LLM_MODEL=qwen3:14b
LLM_CONTEXT=16384
# Pin the Ollama image once a version works (docker compose exec llm ollama -v).
OLLAMA_TAG=latest
# Only for llm.provider: gemini in params.yaml.
GEMINI_API_KEY=
