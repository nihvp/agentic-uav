# Copy to .env (git-ignored); docker compose reads it automatically.
# Local LLM served by the llm service. Must support tool calling and, for the paper
# reproduction, images (vision). 16 GB VRAM is shared with Gazebo and YOLO.
# Text-only alternative used up to Phase 3: qwen3:14b.
LLM_MODEL=qwen3-vl:8b
LLM_CONTEXT=16384
# Pin the Ollama image once a version works (docker compose exec llm ollama -v).
OLLAMA_TAG=latest
# Only for llm.provider: gemini in params.yaml.
GEMINI_API_KEY=
