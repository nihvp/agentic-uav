<?xml version="1.0" ?>
<!--
  Search-and-rescue world for PX4 SITL (Gazebo Harmonic).
  PX4 spawns the vehicle (PX4_SIM_MODEL, e.g. gz_x500_depth); this file contains
  only the environment. The world name must match the file name (PX4_GZ_WORLD).
  System plugins mirror PX4's Tools/simulation/gz/worlds/default.sdf; diff against
  it when bumping the PX4 version.
-->
<sdf version="1.9">
  <world name="search_and_rescue">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Ambient Lighting & Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target 1: Survivor in Orange/Red high-vis jacket -->
    <!-- TODO(Phase 2): replace with a Fuel person model so YOLO "person" can detect it. -->
    <model name="survivor_target">
      <static>true</static>
      <pose>8.0 4.0 0.0 0 0 0</pose>
      <link name="link">
        <visual name="torso">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.1 1</ambient>
            <diffuse>0.9 0.4 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="col">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.4</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Target 2: Fire Hazard Source -->
    <model name="fire_hazard">
      <static>true</static>
      <pose>12.0 5.5 0.0 0 0 0</pose>
      <link name="link">
        <visual name="fire_cone">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry>
            <cone>
              <radius>1.2</radius>
              <length>1.6</length>
            </cone>
          </geometry>
          <material>
            <ambient>0.95 0.15 0.05 1</ambient>
            <diffuse>0.95 0.15 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target 3: Emergency Landing Pad (Blue Circle) -->
    <model name="landing_pad">
      <static>true</static>
      <pose>0.0 8.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="pad_visual">
          <geometry>
            <cylinder>
              <radius>2.0</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.9 1</ambient>
            <diffuse>0.1 0.4 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target 4: Debris Obstacle near Landing Pad -->
    <model name="debris_obstacle">
      <static>true</static>
      <pose>1.5 8.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="debris_visual">
          <geometry>
            <box>
              <size>1.0 1.2 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
